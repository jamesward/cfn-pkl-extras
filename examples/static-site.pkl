/// Example: static sites served through CloudFront in a single stack, with no
/// domain registration. Uses `externalDomains` so nothing is registered, and
/// the `.test` domains (a reserved TLD) infer `customDomain = false`, so each
/// site is served on its CloudFront default domain - no ACM validation or NS
/// delegation. Both sites publish on stack deploy and re-sync on every push to
/// their repo's `main`.
///
/// Prerequisites to deploy: this stack is deployed via CloudFormation Git sync,
/// and the connection's GitHub App can access the source repos.
amends "@cfn-pkl-extras/template.pkl"

import "@cfn-pkl-extras/patterns.pkl"

externalDomains {
  // The `.test` keys are reserved (RFC 2606) and only used for resource naming;
  // they infer `customDomain = false`, so the sites serve on CloudFront.

  // 1) A plain static-files site (repo already contains index.html; no build),
  //    with a few path redirects handled by the CloudFront function.
  ["asdf.test"] {
    staticSite {
      githubRepo = "jamesward-test/asdf"
      redirects {
        // exact path -> absolute path (301)
        new patterns.ExactRedirect { paths { "/old"; "/legacy" }; to = "/" }
        // exact path -> external URL (302)
        new patterns.ExactRedirect { paths { "/gh" }; to = "https://github.com/jamesward-test/asdf"; permanent = false }
        // prefix rewrite: /docs/x -> /x (301), {path} = the part after the prefix
        new patterns.PrefixRedirect { prefix = "/docs/"; to = "/{path}" }
      }
    }
  }

  // 2) A Hugo site (CodeBuild installs Hugo, builds, publishes public/).
  ["hellohugo.test"] {
    staticSite {
      githubRepo = "jamesward-test/hello-hugo"
      build = new patterns.HugoBuild {}
    }
  }

  // 3) A custom-domain site with a `www` -> apex redirect handled by the SAME
  //    CloudFront distribution (cert SAN + distribution alias + a Host-header
  //    301 in the function - no separate distribution/cert).
  //
  //    COMMENTED OUT: a real (non-.test) domain infers `customDomain = true`,
  //    which provisions an ACM cert that DNS-validates against a created hosted
  //    zone. Without delegating that domain's nameservers to the hosted zone,
  //    validation never completes and the stack update hangs. Uncomment and
  //    replace `example.com` with a domain you control (and delegate its NS) to
  //    deploy it.
  //
  // ["example.com"] {
  //   staticSite {
  //     githubRepo = "jamesward-test/asdf"
  //     redirectHosts { "www" }   // www.example.com -> example.com (301)
  //   }
  // }
}

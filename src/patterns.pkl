module `cfn-pkl-extras`.patterns

import "@cfn/cloudformation.pkl"
import "@cfn/aws/route53/recordset.pkl"
import "@cfn/aws/route53/hostedzone.pkl"
import "@cfn/aws/cloudfront/distribution.pkl"
import "@cfn/aws/cloudfront/function.pkl" as cloudfrontFunction
import "@cfn/aws/certificatemanager/certificate.pkl"
import "@cfn/aws/s3/bucket.pkl" as s3bucket
import "@cfn/aws/s3/bucketpolicy.pkl" as s3bucketpolicy
import "@cfn/aws/cloudfront/originaccesscontrol.pkl" as originaccesscontrol
import "@cfn/aws/codebuild/project.pkl" as codebuildproject
import "@cfn/aws/iam/role.pkl" as iamrole
import "route53.pkl"
import "customResources.pkl"


// todo: must not start with a number?
const resourceNameClases = "A-Za-z0-9"
const resourceNameRegex = Regex("[\(resourceNameClases)]+")
const resourceNameInvalidRegex = Regex("[^\(resourceNameClases)]")

typealias ResourceName = String(matches(resourceNameRegex), length < 256)


class BasicRedirect {
  sub: String?
  to: Uri
  permanent: Boolean = false
  aliases: Listing<route53.ValidDomainName>
  preservePath: Boolean = false
}


// todo: can't have ghpages and redirect
class DomainDetails {
  authCode: (String | Mapping)?
  redirect: BasicRedirect?
  ghpages: String?
  staticSite: StaticSite?
  records: Listing<route53.DomainRecord>
  nameServers: Listing<route53.ValidDomainName>
  autoRenew: Boolean = true
  /// Number of years to register or transfer the domain for.
  /// Most TLDs accept 1; some (e.g. .ai) require a minimum of 2.
  /// Allowed range per the AWS Route 53 Domains API: 1–10.
  durationInYears: Int(this >= 1 && this <= 10) = 1
  /// Override the ACM certificate validation method used for a `redirect`.
  /// When `null` (the default), the method is chosen automatically: `EMAIL`
  /// while a transfer is pending (`authCode` set), since DNS validation is
  /// blocked until the domain's nameservers point at Route 53; otherwise `DNS`.
  /// Set explicitly to force a method — e.g. `DNS` when the domain already
  /// delegates to its Route 53 hosted zone even though a transfer is in flight.
  validationMethod: ValidationMethod?

  /// Whether this domain results in a Route 53 hosted zone being created
  /// (mirrors the branch logic in `Domains.apexDomainToResources`). Takes the
  /// apex key because a staticSite's `customDomain` is inferred from the domain.
  function createsHostedZone(apexDomain: route53.ApexDomainName): Boolean =
    redirect != null || ghpages != null || !records.isEmpty
      || (staticSite != null && (staticSite!!) { domainName { name = apexDomain } }.customDomain)
}

class ExternalDomainDetails {
  redirect: BasicRedirect?
  staticSite: StaticSite?
  records: Listing<route53.DomainRecord>

  /// Whether this domain results in a Route 53 hosted zone being created
  /// (mirrors the branch logic in `ExternalDomains.apexDomainToResources`).
  /// Takes the apex key because a staticSite's `customDomain` is inferred from
  /// the domain, and the staticSite's `domainName` is injected from the key.
  function createsHostedZone(apexDomain: route53.ApexDomainName): Boolean =
    redirect != null || !records.isEmpty
      || (staticSite != null && (staticSite!!) { domainName { name = apexDomain } }.customDomain)
}

class Domains {
  contact: route53.Contact
  domains: Mapping<route53.ApexDomainName, DomainDetails>

  function apexDomainToDomain(apexDomain: route53.ApexDomainName, domainDetails: DomainDetails): route53.Domain =
    let (_contact = contact)
      new route53.Domain {
        domainName {
          name = apexDomain
        }
        contact = _contact
        transferAuthCode = domainDetails.authCode
        // todo: the way we set the nameservers is brittle
        nameServers = if (domainDetails.nameServers.isEmpty && (domainDetails.redirect != null || domainDetails.ghpages != null || domainDetails.staticSite != null || !domainDetails.records.isEmpty))
            cloudformation.GetAtt("\(domainName.apexResourceName)HostedZone", "NameServers")
          else
            domainDetails.nameServers
        autoRenew = domainDetails.autoRenew
        durationInYears = domainDetails.durationInYears
      }

  function apexDomainToResources(apexDomain: route53.ApexDomainName, domainDetails: DomainDetails): Mapping<ResourceName, cloudformation.Resource> =
    if (domainDetails.redirect != null)
      new {
        ...apexDomainToDomain(apexDomain, domainDetails).resources
        ...new WebSiteRedirect {
          domainName {
            name = domainDetails.redirect?.sub.ifNonNull((sub) -> "\(sub).\(apexDomain)") ?? apexDomain
          }
          redirect = domainDetails.redirect
          validationMethod = domainDetails.validationMethod ?? (if (domainDetails.authCode != null) "EMAIL" else "DNS") // transferring domains takes a long time, blocking certification creation
        }.resources
        when (!domainDetails.records.isEmpty) {
          ...route53.domainRecords(apexDomain, domainDetails.records)
        }
      }
    else if (domainDetails.ghpages != null)
      new {
        ...apexDomainToDomain(apexDomain, domainDetails).resources
        ...route53.hostedZone(new route53.DomainName { name = apexDomain })
        ...route53.domainRecords(apexDomain, new Listing<route53.DomainRecord> {
          new {
            type = "A"
            values {
              "185.199.108.153"
              "185.199.109.153"
              "185.199.110.153"
              "185.199.111.153"
            }
          }
          new {
            type = "AAAA"
            values {
              "2606:50c0:8000::153"
              "2606:50c0:8001::153"
              "2606:50c0:8002::153"
              "2606:50c0:8003::153"
            }
          }
          new {
            sub = "www"
            type = "CNAME"
            values {
              domainDetails.ghpages!! + ".github.io"
            }
          }
        })
      }
    else if (domainDetails.staticSite != null)
      new {
        ...apexDomainToDomain(apexDomain, domainDetails).resources
        // A real registered domain infers customDomain = true, so the static
        // site creates the hosted zone, cert and alias; the domain's
        // nameservers (above) point at that hosted zone.
        ...(domainDetails.staticSite!!) {
          domainName {
            name = apexDomain
          }
        }.resources
        // Additional records (MX, TXT, subdomains, ...) live in the same zone.
        when (!domainDetails.records.isEmpty) {
          ...route53.domainRecords(apexDomain, domainDetails.records)
        }
      }
    else
      new {
        ...apexDomainToDomain(apexDomain, domainDetails).resources
        when (!domainDetails.records.isEmpty) {
          ...route53.hostedZone(new route53.DomainName { name = apexDomain })
          ...route53.domainRecords(apexDomain, domainDetails.records)
        }
      }


  fixed resources: Mapping<ResourceName, cloudformation.Resource> = new Mapping<ResourceName, cloudformation.Resource> {
    // The domain registration Lambda infra is only needed when there are
    // actually domains to register.
    when (!domains.isEmpty) {
      ...route53.domainCustomResource.resources
    }

    for (apexDomain, domainDetails in domains) {
      ...apexDomainToResources(apexDomain, domainDetails)
    }
  }

  // output the hostedzones
  fixed outputs: Mapping<String, cloudformation.Output> = new {
    ...resources
      .toMap()
      .filter((_, resource) -> resource.Type == "AWS::Route53::HostedZone")
      .mapValues((resourceName, resource) -> new cloudformation.Output {
        Description = "\(resource.Properties["Name"])"
        Value = cloudformation.Ref(resourceName)
        Export {
           Name = resourceName
        }
      })
  }
}

const function distributionRecordSets(domainName: route53.DomainName): Mapping<ResourceName, cloudformation.Resource> =
  new Mapping<ResourceName, cloudformation.Resource> {
    ["\(domainName.resourceName)RecordSetA"] = new recordset.RecordSet {
      HostedZoneId = cloudformation.Ref("\(domainName.apexResourceName)HostedZone")
      Name = domainName.name
      TypeProperty = "A"
      AliasTarget {
        // The following HosteZoneId is always used for alias records pointing to CF.
        HostedZoneId = "Z2FDTNDATAQYW2"
        //HostedZoneId = cloudformation.GetAtt("Distribution", "HostedZoneId")
        DNSName = cloudformation.GetAtt("\(domainName.apexResourceName)Distribution", "DomainName")
        EvaluateTargetHealth = false
      }
    }

    ["\(domainName.resourceName)RecordSetAAAA"] = new recordset.RecordSet {
      HostedZoneId = cloudformation.Ref("\(domainName.apexResourceName)HostedZone")
      Name = domainName.name
      TypeProperty = "AAAA"
      AliasTarget {
        // The following HosteZoneId is always used for alias records pointing to CF.
        HostedZoneId = "Z2FDTNDATAQYW2"
        //HostedZoneId = cloudformation.GetAtt("Distribution", "HostedZoneId")
        DNSName = cloudformation.GetAtt("\(domainName.apexResourceName)Distribution", "DomainName")
        EvaluateTargetHealth = false
      }
    }
  }

typealias ValidationMethod = "DNS" | "EMAIL"

class WebSiteRedirect {

  domainName: route53.DomainName
  redirect: BasicRedirect?
  validationMethod: ValidationMethod

  fixed statusCode = if (redirect.permanent) 301 else 302
  fixed statusDescription = if (redirect.permanent) "Moved Permanently" else "Found"

  fixed postStatusCode = if (redirect.permanent) 308 else 307
  fixed postStatusDescription = if (redirect.permanent) "Permanent Redirect" else "Temporary Redirect"

  fixed redirector: String =
    if (redirect.preservePath)
      """
      function handler(event) {
        var path = event.request.uri
        var statusCode = (event.request.method === 'POST') ? \(postStatusCode) : \(statusCode)
        var statusDescription = (event.request.method === 'POST') ? '\(postStatusDescription)' : '\(statusDescription)'
        var qs = Object.keys(event.request.querystring)
          .map(function(k) {
            var val = event.request.querystring[k].value;
            return val ? k + '=' + val : k;
          })
          .join('&')

        return {
          statusCode: statusCode,
          statusDescription: statusDescription,
          headers: {
            'location': { value: '\(redirect.to)' + path + (qs ? '?' + qs : '') }
          }
        };
      }
      """
    else
      """
      function handler(event) {
        var statusCode = (event.request.method === 'POST') ? \(postStatusCode) : \(statusCode)
        var statusDescription = (event.request.method === 'POST') ? '\(postStatusDescription)' : '\(statusDescription)'

        return {
          statusCode: statusCode,
          statusDescription: statusDescription,
          headers: {
            'location': { value: '\(redirect.to)' }
          }
        };
      }
      """

  fixed resources: Mapping<ResourceName, cloudformation.Resource> = new {
    ...route53.hostedZone(domainName)

    ...distributionRecordSets(domainName)

    for (alias in redirect.aliases) {
      ...distributionRecordSets(new route53.DomainName { name = alias })
    }

    ["\(domainName.apexResourceName)Certificate"] = new certificate.Certificate {
      DomainName = domainName.name
      ValidationMethod = validationMethod
      // Adds the validation record to the hostedzone
      DomainValidationOptions {
        new {
          DomainName = domainName.name
          when (validationMethod == "DNS") {
            HostedZoneId = cloudformation.Ref("\(domainName.apexResourceName)HostedZone")
          }
          when (validationMethod == "EMAIL") {
            ValidationDomain = domainName.apex
          }
        }
        for (alias in redirect.aliases) {
          new {
            DomainName = alias
            when (validationMethod == "DNS") {
              HostedZoneId = cloudformation.Ref("\(domainName.apexResourceName)HostedZone")
            }
            when (validationMethod == "EMAIL") {
              ValidationDomain = domainName.apex
            }
          }
        }
      }
      SubjectAlternativeNames = redirect.aliases
    }

    ["\(domainName.apexResourceName)DistributionFunction"] = new cloudfrontFunction.Function {
      Name = "\(domainName.apexResourceName)Redirect"
      AutoPublish = true
      FunctionCode = redirector
      FunctionConfig {
        Comment = "Redirect-All"
        Runtime = "cloudfront-js-1.0"
      }
    }

    ["\(domainName.apexResourceName)Distribution"] = new distribution.Distribution {
      DistributionConfig {
        Enabled = true
        DefaultCacheBehavior {
          ViewerProtocolPolicy = "redirect-to-https"
          TargetOriginId = "dummy-origin"
          FunctionAssociations {
            new {
              EventType = "viewer-request"
              FunctionARN = cloudformation.GetAtt("\(domainName.apexResourceName)DistributionFunction", "FunctionMetadata.FunctionARN")
            }
          }
          ForwardedValues {
            QueryString = false
          }
          AllowedMethods {
            "HEAD"
            "DELETE"
            "POST"
            "GET"
            "OPTIONS"
            "PUT"
            "PATCH"
          }
        }
        Origins {
          new {
            Id = "dummy-origin"
            DomainName = domainName.name
            CustomOriginConfig {
              OriginProtocolPolicy = "https-only"
            }
          }
        }
        HttpVersion = "http2"
        Aliases {
          domainName.name
          ...redirect.aliases
        }
        ViewerCertificate {
          AcmCertificateArn = cloudformation.Ref("\(domainName.apexResourceName)Certificate")
          SslSupportMethod = "sni-only"
        }
      }
    }
  }
}


/// How the site is produced before publishing to S3. Closed set of strategies
/// so a site is always exactly one known build type.
abstract class SiteBuild {
  /// Directory (relative to the repo root) synced to S3 after the build.
  publishDir: String
  /// Whether CodeBuild should fetch git submodules (e.g. a Hugo theme).
  fetchSubmodules: Boolean = false
  /// Commands run in the CodeBuild `build` phase. Empty means "no build".
  buildCommands: Listing<String> = new Listing {}
}

/// No build step: the repository already contains the static files to serve
/// (e.g. a plain `index.html`). The published directory is synced to S3 as-is.
class StaticFiles extends SiteBuild {
  /// Optional subdirectory (relative to the repo root) containing the files to
  /// publish. Defaults to the repo root.
  subdir: String?
  publishDir = subdir ?? "."
}

/// Build a Hugo site and publish its `public/` output.
class HugoBuild extends SiteBuild {
  /// Hugo (extended) version installed in the build.
  hugoVersion: String = "0.148.0"
  fetchSubmodules = true
  publishDir = "public"
  buildCommands = new Listing {
    "curl -sSL \"https://github.com/gohugoio/hugo/releases/download/v\(hugoVersion)/hugo_extended_\(hugoVersion)_linux-amd64.tar.gz\" | tar -xz -C /usr/local/bin hugo"
    "hugo --gc --minify --baseURL \"https://${SITE_URL}/\""
  }
}

/// A path redirect served by the site's CloudFront viewer-request function.
/// Closed set: a request path either matches exactly or by prefix.
abstract class SiteRedirect {
  /// Destination: an absolute path ("/foo") or an absolute URL
  /// ("https://example.com/..."). For PrefixRedirect, `{path}` is replaced with
  /// the part of the request path after `prefix`.
  to: String
  /// 301 Moved Permanently (default) or 302 Found.
  permanent: Boolean = true
  fixed statusCode: Int = if (permanent) 301 else 302
  fixed statusDescription: String = if (permanent) "Moved Permanently" else "Found"
}

/// Redirects when the request path exactly equals one of `paths`.
class ExactRedirect extends SiteRedirect {
  paths: Listing<String>(!isEmpty)
}

/// Redirects when the request path starts with `prefix`; the remainder after
/// `prefix` is substituted for `{path}` in `to`.
class PrefixRedirect extends SiteRedirect {
  prefix: String
}

/// A static website: a private S3 origin behind CloudFront (via Origin Access
/// Control, not S3 website hosting), built and deployed by CodeBuild on push to
/// `branch`. CodeBuild's GitHub source authenticates with the CodeConnections
/// connection resolved by the `ConnectionLookup` custom resource (the same
/// connection that deploys this stack via Git sync), so no connection ARN is
/// hard-coded.
class StaticSite {
  /// The domain associated with this site. When used via `externalDomains` it
  /// is injected from the apex key. Used for resource naming and, when
  /// `customDomain` is true, for the ACM cert, CloudFront alias and Route 53
  /// alias records.
  domainName: route53.DomainName

  /// GitHub "org/repo" the site content is built from.
  githubRepo: String(split("/").length == 2)

  /// Branch whose pushes trigger a build + deploy.
  branch: String = "main"

  /// CodeConnections ARN for this site's GitHub source. Defaults to the
  /// connection that deploys the stack (resolved by the shared ConnectionLookup)
  /// - correct when the repo is in the same GitHub org/account as the deploy
  /// connection. Override with an explicit ARN (or intrinsic) when the repo is
  /// in a different org/account, since CodeConnections connections are 1:1 per
  /// org.
  connectionArn: (String | Mapping) = cloudformation.GetAtt("ConnectionLookup", "ConnectionArn")

  /// Internal, derived: whether this site serves on `domainName` (ACM cert +
  /// CloudFront alias + Route 53 records) or on the CloudFront default domain.
  /// Not user-settable - it's inferred from the domain: reserved test TLDs
  /// (RFC 2606 - `.test`, `.example`, `.invalid`, `.localhost`) never resolve,
  /// so they serve on CloudFront (no ACM validation / NS delegation); every
  /// other (real) domain serves on its custom domain.
  fixed customDomain: Boolean =
    !(List("test", "example", "invalid", "localhost").contains(domainName.name.split(".").last))

  /// How the site is built before publishing. Defaults to publishing the
  /// repository's files as-is (no build step).
  build: SiteBuild = new StaticFiles {}

  /// Path redirects served by the CloudFront viewer-request function (checked
  /// before the directory-index rewrite).
  redirects: Listing<SiteRedirect> = new Listing {}

  /// Subdomain labels of the canonical domain (e.g. "www") that are served by
  /// THIS distribution and 301-redirect to the canonical domain, handled in the
  /// CloudFront function via the Host header - no separate distribution or
  /// certificate. Each becomes a certificate SAN, a distribution alias, and a
  /// Route 53 alias record. Requires `customDomain`.
  redirectHosts: Listing<String>(this.isEmpty || customDomain) = new Listing {}

  fixed redirectHostNames: Listing<String> =
    redirectHosts.toList().map((h) -> "\(h).\(domainName.name)").toListing()

  fixed resourceName: ResourceName = domainName.resourceName
  fixed apexResourceName: ResourceName = domainName.apexResourceName

  // A single viewer-request function handles path redirects first, then the
  // directory-index rewrite (S3+OAC, unlike S3 website hosting, does not append
  // an index document for directory requests).
  fixed indexFunctionCode: String = new Listing {
    "function handler(event) {"
    "  var request = event.request;"
    "  var uri = request.uri;"
    when (!redirectHosts.isEmpty) {
      "  var host = request.headers.host.value;"
      "  if (host !== '\(domainName.name)') {"
      "    var qs = Object.keys(request.querystring).map(function(k){ var v = request.querystring[k].value; return v ? k + '=' + v : k; }).join('&');"
      "    return { statusCode: 301, statusDescription: 'Moved Permanently', headers: { location: { value: 'https://\(domainName.name)' + uri + (qs ? '?' + qs : '') } } };"
      "  }"
    }
    for (r in redirects) {
      when (r is ExactRedirect) {
        "  if (\(r.paths.toList().map((p) -> "uri === '\(p)'").join(" || "))) {"
        "    return { statusCode: \(r.statusCode), statusDescription: '\(r.statusDescription)', headers: { location: { value: '\(r.to)' } } };"
        "  }"
      }
      when (r is PrefixRedirect) {
        "  if (uri.startsWith('\(r.prefix)')) {"
        when (r.to.contains("{path}")) {
          "    var rest = uri.substring(\(r.prefix.length));"
          "    return { statusCode: \(r.statusCode), statusDescription: '\(r.statusDescription)', headers: { location: { value: '\(r.to.replaceAll("{path}", "' + rest + '"))' } } };"
        }
        when (!r.to.contains("{path}")) {
          "    return { statusCode: \(r.statusCode), statusDescription: '\(r.statusDescription)', headers: { location: { value: '\(r.to)' } } };"
        }
        "  }"
      }
    }
    "  if (uri.endsWith('/')) {"
    "    request.uri += 'index.html';"
    "  } else if (!uri.includes('.')) {"
    "    request.uri += '/index.html';"
    "  }"
    "  return request;"
    "}"
  }.join("\n")

  // Env vars (BUCKET, DISTRIBUTION_ID, HUGO_VERSION, SITE_URL) are injected by
  // the CodeBuild project, so the buildspec stays free of resource ids.
  // Env vars (BUCKET, DISTRIBUTION_ID, SITE_URL) are injected by the CodeBuild
  // project, so the buildspec stays free of resource ids. The build phase is
  // omitted entirely when the strategy has no build commands (StaticFiles).
  // An optional `.slugignore` (Heroku-style: one glob per line, `#` comments)
  // in the repo adds `--exclude` patterns to the sync.
  fixed buildSpec: String = new Listing {
    "version: 0.2"
    "phases:"
    when (!build.buildCommands.isEmpty) {
      "  build:"
      "    commands:"
      for (cmd in build.buildCommands) {
        "      - \(cmd)"
      }
    }
    "  post_build:"
    "    commands:"
    "      - EXCLUDES=\"--exclude '.git/*' --exclude '.slugignore'\"; if [ -f .slugignore ]; then while IFS= read -r p; do case \"$p\" in ''|'#'*) ;; *) EXCLUDES=\"$EXCLUDES --exclude '$p'\";; esac; done < .slugignore; fi; eval aws s3 sync \(build.publishDir)/ \"s3://${BUCKET}/\" --delete $EXCLUDES"
    "      - aws cloudfront create-invalidation --distribution-id \"${DISTRIBUTION_ID}\" --paths '/*'"
  }.join("\n")

  fixed resources: Mapping<ResourceName, cloudformation.Resource> = new {
    ["\(resourceName)Bucket"] = new s3bucket.Bucket {
      PublicAccessBlockConfiguration {
        BlockPublicAcls = true
        BlockPublicPolicy = true
        IgnorePublicAcls = true
        RestrictPublicBuckets = true
      }
    }

    ["\(resourceName)OriginAccessControl"] = new originaccesscontrol.OriginAccessControl {
      OriginAccessControlConfig {
        Name = "\(resourceName)-oac"
        OriginAccessControlOriginType = "s3"
        SigningBehavior = "always"
        SigningProtocol = "sigv4"
      }
    }

    ["\(resourceName)IndexFunction"] = new cloudfrontFunction.Function {
      Name = "\(resourceName)Index"
      AutoPublish = true
      FunctionCode = indexFunctionCode
      FunctionConfig {
        Comment = "Directory index rewrite"
        Runtime = "cloudfront-js-1.0"
      }
    }

    ["\(resourceName)Distribution"] = new distribution.Distribution {
      DistributionConfig {
        Enabled = true
        DefaultRootObject = "index.html"
        HttpVersion = "http2"
        DefaultCacheBehavior {
          TargetOriginId = "s3-origin"
          ViewerProtocolPolicy = "redirect-to-https"
          Compress = true
          AllowedMethods { "GET"; "HEAD" }
          CachedMethods { "GET"; "HEAD" }
          ForwardedValues { QueryString = false }
          FunctionAssociations {
            new {
              EventType = "viewer-request"
              FunctionARN = cloudformation.GetAtt("\(resourceName)IndexFunction", "FunctionMetadata.FunctionARN")
            }
          }
        }
        Origins {
          new {
            Id = "s3-origin"
            DomainName = cloudformation.GetAtt("\(resourceName)Bucket", "RegionalDomainName")
            OriginAccessControlId = cloudformation.Ref("\(resourceName)OriginAccessControl")
            S3OriginConfig { OriginAccessIdentity = "" }
          }
        }
        when (customDomain) {
          Aliases {
            domainName.name
            ...redirectHostNames
          }
          ViewerCertificate {
            AcmCertificateArn = cloudformation.Ref("\(apexResourceName)Certificate")
            SslSupportMethod = "sni-only"
            MinimumProtocolVersion = "TLSv1.2_2021"
          }
        }
        when (!customDomain) {
          ViewerCertificate {
            CloudFrontDefaultCertificate = true
          }
        }
      }
    }

    ["\(resourceName)BucketPolicy"] = new s3bucketpolicy.BucketPolicy {
      Bucket = cloudformation.Ref("\(resourceName)Bucket")
      PolicyDocument {
        Version = "2012-10-17"
        Statement {
          new {
            Effect = "Allow"
            Principal { Service = "cloudfront.amazonaws.com" }
            Action = "s3:GetObject"
            Resource = cloudformation.Sub("${\(resourceName)Bucket.Arn}/*")
            Condition {
              StringEquals {
                ["AWS:SourceArn"] = cloudformation.Sub("arn:aws:cloudfront::${AWS::AccountId}:distribution/${\(resourceName)Distribution}")
              }
            }
          }
        }
      }
    }

    ["\(resourceName)BuildRole"] = new iamrole.Role {
      AssumeRolePolicyDocument {
        Version = "2012-10-17"
        Statement {
          Effect = "Allow"
          Principal { Service = "codebuild.amazonaws.com" }
          Action = "sts:AssumeRole"
        }
      }
      Policies {
        new {
          PolicyName = "Deploy"
          PolicyDocument {
            Version = "2012-10-17"
            Statement {
              new {
                Effect = "Allow"
                Action { "logs:CreateLogGroup"; "logs:CreateLogStream"; "logs:PutLogEvents" }
                Resource = cloudformation.Sub("arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/codebuild/*")
              }
              new {
                Effect = "Allow"
                Action { "s3:PutObject"; "s3:GetObject"; "s3:DeleteObject"; "s3:ListBucket" }
                Resource {
                  cloudformation.Sub("${\(resourceName)Bucket.Arn}")
                  cloudformation.Sub("${\(resourceName)Bucket.Arn}/*")
                }
              }
              new {
                Effect = "Allow"
                Action { "cloudfront:CreateInvalidation" }
                Resource = cloudformation.Sub("arn:aws:cloudfront::${AWS::AccountId}:distribution/${\(resourceName)Distribution}")
              }
              new {
                // Scoped to the resolved connection; lets CodeBuild use it as a source.
                Effect = "Allow"
                Action { "codeconnections:GetConnectionToken"; "codeconnections:GetConnection"; "codeconnections:UseConnection" }
                Resource = connectionArn
              }
            }
          }
        }
      }
    }

    ["\(resourceName)BuildProject"] = new codebuildproject.Project {
      ServiceRole = cloudformation.GetAtt("\(resourceName)BuildRole", "Arn")
      Artifacts { Type = "NO_ARTIFACTS" }
      Environment {
        Type = "LINUX_CONTAINER"
        ComputeType = "BUILD_GENERAL1_SMALL"
        Image = "aws/codebuild/amazonlinux2-x86_64-standard:5.0"
        EnvironmentVariables {
          new { Name = "BUCKET"; Value = cloudformation.Ref("\(resourceName)Bucket") }
          new { Name = "DISTRIBUTION_ID"; Value = cloudformation.Ref("\(resourceName)Distribution") }
          new { Name = "SITE_URL"; Value = if (customDomain) domainName.name else cloudformation.GetAtt("\(resourceName)Distribution", "DomainName") }
        }
      }
      Source {
        Type = "GITHUB"
        Location = "https://github.com/\(githubRepo).git"
        Auth {
          Type = "CODECONNECTIONS"
          Resource = connectionArn
        }
        BuildSpec = buildSpec
        when (build.fetchSubmodules) {
          GitSubmodulesConfig { FetchSubmodules = true }
        }
      }
      SourceVersion = "refs/heads/\(branch)"
      Triggers {
        Webhook = true
        FilterGroups {
          new {
            new Mapping { ["Type"] = "EVENT"; ["Pattern"] = "PUSH" }
            new Mapping { ["Type"] = "HEAD_REF"; ["Pattern"] = "^refs/heads/\(branch)$" }
          }
        }
      }
    }

    // Publish on stack deploy: start the build and wait for it to finish, so
    // the site is populated immediately rather than only on the next push.
    ...customResources.triggerBuild("\(resourceName)TriggerBuild", "\(resourceName)BuildProject")

    when (customDomain) {
      ...route53.hostedZone(domainName)
      ["\(apexResourceName)Certificate"] = new certificate.Certificate {
        DomainName = domainName.name
        ValidationMethod = "DNS"
        DomainValidationOptions {
          new {
            DomainName = domainName.name
            HostedZoneId = cloudformation.Ref("\(apexResourceName)HostedZone")
          }
          for (h in redirectHostNames) {
            new {
              DomainName = h
              HostedZoneId = cloudformation.Ref("\(apexResourceName)HostedZone")
            }
          }
        }
        when (!redirectHostNames.isEmpty) {
          SubjectAlternativeNames = redirectHostNames
        }
      }
      ...distributionRecordSets(domainName)
      for (h in redirectHostNames) {
        ...distributionRecordSets(new route53.DomainName { name = h })
      }
    }
  }
}


class ExternalDomains {

  domains: Mapping<route53.ApexDomainName, ExternalDomainDetails>

  function apexDomainToResources(apexDomain: route53.ApexDomainName, externalDomainDetails: ExternalDomainDetails): Mapping<ResourceName, cloudformation.Resource> =
    if (externalDomainDetails.redirect != null)
      new {
        ...new WebSiteRedirect {
          domainName {
            name = externalDomainDetails.redirect?.sub.ifNonNull((sub) -> "\(sub).\(apexDomain)") ?? apexDomain
          }
          redirect = externalDomainDetails.redirect
          validationMethod = "DNS"
        }.resources
        when (!externalDomainDetails.records.isEmpty) {
          ...route53.domainRecords(apexDomain, externalDomainDetails.records)
        }
      }
    else if (externalDomainDetails.staticSite != null)
      new {
        // Inject the domain from the apex key so the site doesn't repeat it.
        ...(externalDomainDetails.staticSite!!) {
          domainName {
            name = apexDomain
          }
        }.resources
        // Extra records only make sense alongside a custom-domain site (which
        // creates the hosted zone they attach to).
        when (!externalDomainDetails.records.isEmpty) {
          ...route53.domainRecords(apexDomain, externalDomainDetails.records)
        }
      }
    else
      new {
        when (!externalDomainDetails.records.isEmpty) {
          ...route53.hostedZone(new route53.DomainName { name = apexDomain })
          ...route53.domainRecords(apexDomain, externalDomainDetails.records)
        }
      }

  hidden resources: Mapping<ResourceName, cloudformation.Resource> =
    new Mapping<ResourceName, cloudformation.Resource> {
      for (apexDomainName, externalDomainDetails in domains) {
        ...apexDomainToResources(apexDomainName, externalDomainDetails)
      }
    }

  // output the hostedzones
  fixed outputs: Mapping<String, cloudformation.Output> = new {
    ...resources
      .toMap()
      .filter((_, resource) -> resource.Type == "AWS::Route53::HostedZone")
      .mapValues((resourceName, resource) -> new cloudformation.Output {
      Description = "\(resource.Properties["Name"])"
      Value = cloudformation.Ref(resourceName)
      Export {
        Name = resourceName
      }
    })
  }
}

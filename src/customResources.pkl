module `cfn-pkl-extras`.customResources

import "patterns.pkl"
import "@cfn/cloudformation.pkl" as cfn
import "@cfn/aws/iam/role.pkl" as role

// The published cfn-extras-resource Lambda artifact, consumed via Lambda
// self-managed S3 code storage (REFERENCE mode) - one public, versioned object
// backs every custom resource; each Lambda just selects its entrypoint via
// Handler (e.g. cfn_extras.domain.handler). REFERENCE lets the single us-east-1
// bucket back Lambdas in any standard region.
//
// To adopt a new cfn-extras-resource release, bump `artifactObjectVersion` to
// the value published in versions/<tag>.json in the artifact bucket.
const artifactBucket: String = "cfn-extras-resource"
const artifactKey: String = "cfn-extras-resource.zip"
const artifactObjectVersion: String = "gpucdYhAHtURnEC1jLVSotYBtr5h6A56" // v0.0.1

class Allow {
  actions: Listing<String>
  resource: Listing
}

// A custom resource backed by a handler in the shared published artifact.
class CustomResource {
  resourceName: patterns.ResourceName
  // Handler in the published artifact, e.g. "cfn_extras.domain.handler".
  handler: String
  runtime: String = "python3.13"
  timeout: Duration = 60.s
  // One IAM statement per Allow, so actions with differing resource-level
  // support can be scoped independently (least privilege).
  allow: Listing<Allow> = new Listing {}
  managedPolicyArns: Listing<String> = new Listing {}

  fixed resources: Mapping<patterns.ResourceName, cfn.Resource> =
    new Mapping<patterns.ResourceName, cfn.Resource> {
      ["\(resourceName)Role"] = new role.Role {
        AssumeRolePolicyDocument {
          Statement {
            Effect = "Allow"
            Principal {
              Service = "lambda.amazonaws.com"
            }
            Action = "sts:AssumeRole"
          }
        }
        ManagedPolicyArns {
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
          ...managedPolicyArns
        }
        when (!allow.isEmpty) {
          Policies {
            new {
              PolicyName = resourceName
              PolicyDocument {
                Version = "2012-10-17"
                Statement {
                  for (_allow in allow) {
                    new {
                      Effect = "Allow"
                      Action = _allow.actions
                      Resource = _allow.resource
                    }
                  }
                }
              }
            }
          }
        }
      }

      // Raw resource: the cfn package's typed Lambda Code lacks
      // S3ObjectStorageMode (self-managed storage), so pass Properties directly.
      ["\(resourceName)Function"] = new cfn.Resource {
        Type = "AWS::Lambda::Function"
        Properties = new Mapping {
          ["Runtime"] = runtime
          ["Handler"] = handler
          ["Timeout"] = timeout.toUnit("s").value.toInt()
          ["Role"] = cfn.GetAtt("\(resourceName)Role", "Arn")
          ["Code"] = new Mapping {
            ["S3Bucket"] = artifactBucket
            ["S3Key"] = artifactKey
            ["S3ObjectVersion"] = artifactObjectVersion
            ["S3ObjectStorageMode"] = "REFERENCE"
          }
        }
      }
    }

  function instance(properties: Mapping): cfn.Resource =
    new cfn.Resource {
      Type = "AWS::CloudFormation::CustomResource"
      Properties = new Mapping {
        ["ServiceTimeout"] = (timeout + 1.min).toUnit("s").value.toInt()
        ["ServiceToken"] = cfn.GetAtt("\(resourceName)Function", "Arn")
        ...properties
      }
    }
}


// A generic "call the AWS SDK" custom resource, modeled on CDK's
// `AwsCustomResource` - one shared Lambda (cfn_extras.sdk_call) invokes a boto3
// client method and returns the flattened response for Fn::GetAtt. `policy` is
// the (aggregated) IAM the calls need. Create instances with
// `.instance({ Service, Action, Parameters, PhysicalResourceIdPath })`.
function sdkCall(policy: Listing<Allow>): CustomResource = new CustomResource {
  resourceName = "SdkCall"
  handler = "cfn_extras.sdk_call.handler"
  timeout = 60.s
  allow = policy
}


// Runs `codebuild:StartBuild` on `projectResourceName` and waits for it to
// finish, as a CloudFormation custom resource. Use this to run a build on stack
// create/update (e.g. to publish a static site immediately on deploy). Fails
// the stack if the build fails.
function triggerBuild(triggerResourceName: patterns.ResourceName, projectResourceName: patterns.ResourceName): Mapping<patterns.ResourceName, cfn.Resource> =
  let (cr = new CustomResource {
    resourceName = triggerResourceName
    handler = "cfn_extras.trigger_build.handler"
    timeout = 900.s
    allow {
      new Allow {
        actions {
          "codebuild:StartBuild"
          "codebuild:BatchGetBuilds"
        }
        resource {
          cfn.GetAtt(projectResourceName, "Arn")
        }
      }
    }
  })
    new Mapping {
      ...cr.resources
      [triggerResourceName] = cr.instance(new Mapping {
        ["ProjectName"] = cfn.Ref(projectResourceName)
      })
    }

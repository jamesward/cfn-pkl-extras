module `cfn-pkl-extras`.template

import "@cfn/template.pkl" as cloudformationTemplate
import "@cfn/aws/cloudfront/function.pkl" as cloudfrontFunction
import "route53.pkl"
import "patterns.pkl"

/// The domain name contact to be applied to all records.
/// Required only when `registeredDomains` has entries (registering/transferring
/// a domain needs a contact); optional for externalDomains-only stacks.
contact: route53.Contact?

/// Domains to be registered with / transfered to Route53
registeredDomains: Mapping<route53.ApexDomainName, patterns.DomainDetails>(this.isEmpty || contact != null)

/// Domains registered on external registrars
externalDomains: Mapping<route53.ApexDomainName, patterns.ExternalDomainDetails>

// todo: some way to set a contact per domain
fixed cloudFormation: cloudformationTemplate =
  let (_contact = contact)
  // The HostedZoneManager Lambda infra is only needed when some domain actually
  // creates a Route 53 hosted zone. Computed before `externalDomains` is
  // shadowed by the local below.
  let (_needsHostedZone =
    registeredDomains.keys.toList().any((k) -> registeredDomains[k].createsHostedZone(k))
      || externalDomains.keys.toList().any((k) -> externalDomains[k].createsHostedZone(k))
  )
  // The connection-lookup resources are shared by all StaticSites, so emit them
  // once when any domain (registered or external) has a staticSite.
  let (_needsConnectionLookup =
    registeredDomains.toMap().values.any((d) -> d.staticSite != null)
      || externalDomains.toMap().values.any((d) -> d.staticSite != null)
  )
  let (domains = new patterns.Domains {
    contact = _contact
    domains = registeredDomains
  })
  let (externalDomains = new patterns.ExternalDomains {
    domains = externalDomains
  })

  // Assemble all resources, then serialize CloudFront Function creation: CFN
  // otherwise creates them all in parallel, which bursts past CloudFront's API
  // rate limit ("Rate exceeded" / ServiceLimitExceeded) on larger stacks. A
  // DependsOn chain forces one-at-a-time create/update/delete.
  let (_allResources = new Mapping {
    when (_needsHostedZone) {
      ...route53.hostedZoneCustomResource.resources
    }
    when (_needsConnectionLookup) {
      ...route53.connectionLookupResources()
    }
    ...domains.resources
    ...externalDomains.resources
  })
  let (_cfFunctionIds =
    _allResources.keys.toList().filter((k) -> _allResources[k] is cloudfrontFunction.Function)
  )

  new {
    Resources = (_allResources) {
      for (_i, _fid in _cfFunctionIds) {
        when (_i > 0) {
          [_fid] {
            DependsOn {
              _cfFunctionIds[_i - 1]
            }
          }
        }
      }
    }

    Outputs {
      ...domains.outputs
      ...externalDomains.outputs
    }
  }

output = cloudFormation.output
